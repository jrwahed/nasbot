# ============================================================
#  نسبوط — متغيرات البيئة
#  انسخ الملف ده لـ .env.local واملا القيم.
#  ممنوع أي مفتاح يتحط في الكود، وممنوع أي قيمة حقيقية تتحط في الملف ده.
#  كل متغير هنا موجود لأن الكود بيقراه فعلًا (اتعمله grep على process.env).
# ============================================================

# ---------- Supabase (لازم) ----------
# عنوان المشروع. بيتقرا في: src/lib/supabase.ts · src/lib/copy.ts ·
# src/lib/server/supabase-admin.ts · src/app/api/pay/* · scripts/* · next.config.mjs
# بتجيبه من: Supabase Dashboard ← Project Settings ← API ← Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# المفتاح العام — بيتبعت للمتصفح، وآمن لأن RLS هي اللي بتحمي.
# بتجيبه من: Supabase Dashboard ← Project Settings ← API ← anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح الخدمة — الخادم بس. ممنوع نهائيًا في أي ملف تحت src/components
# أو src/app/**/page.tsx. بيتقرا في: src/lib/server/supabase-admin.ts ·
# scripts/dump-migrations.ts · scripts/fix-orphan-auth.ts
# بتجيبه من: Supabase Dashboard ← Project Settings ← API ← service_role
# ⚠ لو المفتاح ده اتلزق في أي مكان مكشوف قبل كده — دوّره قبل النشر.
SUPABASE_SERVICE_ROLE_KEY=

# اتصال مباشر بالقاعدة — للهجرات والتصدير من الطرفية بس (مش بيتقرا من الكود).
# بتجيبه من: Supabase Dashboard ← Project Settings ← Database ← Connection string
SUPABASE_DB_URL=

# ---------- الموقع ----------
# أصل الموقع. بيتقرا في: src/app/sitemap.ts و src/app/robots.ts
# على Vercel سيبه فاضي في المعاينة (بيتحسب من VERCEL_PROJECT_PRODUCTION_URL)
# وحطّه بالدومين الحقيقي في الإنتاج.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# بديل خادمي لنفس الحاجة (بيتقرا في sitemap.ts لو NEXT_PUBLIC_SITE_URL فاضي)
APP_URL=http://localhost:3000

# للسكريبتات المحلية بس: scripts/check-admin.ts · scripts/dev-session.ts
SITE_URL=http://localhost:3210

# ---------- واتساب (رمز الدخول) ----------
# meta = واجهة ميتا مباشرة · local = مزود محلي
# بيتقرا في: src/lib/server/whatsapp.ts
WHATSAPP_PROVIDER=meta
# توكن دائم من: Meta for Developers ← WhatsApp ← API Setup
WHATSAPP_TOKEN=
# رقم المرسل: نفس الصفحة ← Phone number ID
WHATSAPP_PHONE_ID=
# اسم القالب المعتمد في Meta لرسالة الرمز
WHATSAPP_TEMPLATE_AUTH=nasbot_auth_code

# البديل لو واتساب فشل — بيتقرا في: src/lib/server/whatsapp.ts
SMS_PROVIDER=
SMS_PROVIDER_KEY=
SMS_SENDER_ID=

# ---------- الأمان والمهام ----------
# سر المهام المجدولة. بيتقرا في: src/app/api/copy/revalidate/route.ts
# (وهيتستخدم في أي مسار /api/cron/* لو اتفعّل بعدين).
# المهام المفعّلة دلوقتي على pg_cron جوه سوبابيس — مش Vercel Crons (ADMIN_PLAN §0.2).
# ولّده بأي حاجة عشوائية طويلة، مثلًا: openssl rand -hex 32
CRON_SECRET=

# سر تشفير بيانات الدخول للوحة (HMAC).
# بيتقرا في: src/lib/server/admin-auth.ts
# بيتخبط بيه رقم الموبايل في سجل محاولات الدخول، وبيدخل في هاش جلسة الإدارة.
# ⚠ لو سبته فاضي بيرجع لـ CRON_SECRET، ولو ده كمان فاضي بيرجع لكلمة ثابتة
#   معروفة للكل — يعني أرقام الموبايل في السجل تبقى مكشوفة بالتخمين.
#   ولّده بـ: openssl rand -hex 32
ADMIN_AUTH_PEPPER=

# أرقام الاختبار — بتقبل الرمز 1234 في غير الإنتاج بس.
# بيتقرا في: src/app/api/otp/send/route.ts · scripts/check-admin.ts · scripts/dev-session.ts
# ⚠ لازم تفضل فاضية في الإنتاج.
TEST_PHONE_ALLOWLIST=

# ---------- الدفع ----------
# مفيش بوابة دلوقتي. الدفع تحويل يدوي على فودافون كاش أو إنستا باي،
# والإدارة بتأكد من لوحة /admin.
#
# أرقام التحويل مش هنا — هي في جدول settings علشان تتغير من غير نشر:
#   update settings set vodafone_number = '010 xxxx xxxx',
#                       instapay_handle = 'name@instapay';
# ⚠ لسه القيمة الافتراضية '010 0000 0000' — لازم تتغيّر قبل النشر.
#
# لما تحوّلها تجاري وتفتح بوابة (بايموب/كاشير)، ارجع لـ RUNBOOK.md §11.

# ---------- متغيرات أدوات (اختيارية) ----------
# مجلد البناء — بيتقرا في next.config.mjs. بيخلّي البناء يشتغل من غير
# ما يضرب سيرفر التطوير وهو شغال. مثال: NEXT_DIST_DIR=.next-build
# ⚠ للطرفية بس — متحطهوش على Vercel (وحتى لو اتحط، next.config.mjs بيتجاهله هناك).
NEXT_DIST_DIR=

# عنوان الاختبارات واللقطات — playwright.config.ts · scripts/shots.ts · scripts/ref-shots.ts
BASE_URL=http://localhost:3000

# حد أقصى للنتايج في فاحص النصوص — scripts/check-copy.mjs
MAX=

# ---------- لسه مش متوصّلة في الكود ----------
# محجوزين لخدمات جاية. سيبهم فاضيين دلوقتي.
RESEND_API_KEY=
SENTRY_DSN=
